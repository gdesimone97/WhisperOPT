    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}",
            "justMyCode": false
        },
        {
            "name": "aiq",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "connect": {
                "host": "ainode01",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "/home/dsmgpp000/code/WhisperOPT",
                    "remoteRoot": "/home/dsmgpp000/code/WhisperOPT"
                }
            ]
        },
        {
            "name": "gpuq",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "connect": {
                "host": "gnode11",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "/home/dsmgpp000/code/WhisperOPT",
                    "remoteRoot": "/home/dsmgpp000/code/WhisperOPT"
                }
            ]
        }
    ]
}